# io-vaj-phase0a-builder:c9cc6b28-ac272 — the frozen VAJ builder plus GNU
# Autoconf 2.72. The frozen tag io-vaj-phase0a-builder:c9cc6b28 is untouched;
# this is a layer on top of it.
#
# Why: upstream termux-packages moved its builder to Ubuntu 26.04 (autoconf
# 2.72) and python 3.14's configure.ac requires >= 2.72. On the 24.04-based
# frozen image (autoconf 2.71) python -- and every package that pulls it as a
# build dependency -- fails at autoreconf. Nothing else changes.
#
# Build (on a machine that has the frozen image loaded):
#   docker build -t io-vaj-phase0a-builder:c9cc6b28-ac272 -f scripts/vaj/Dockerfile.builder-ac272 .
# Use:
#   VAJ_BUILDER_IMAGE=io-vaj-phase0a-builder:c9cc6b28-ac272 ./remote-build.sh ...
FROM io-vaj-phase0a-builder:c9cc6b28
USER root
RUN set -eux; cd /tmp; \
    curl -fsSL --retry 3 -o autoconf-2.72.tar.xz https://ftpmirror.gnu.org/autoconf/autoconf-2.72.tar.xz \
      || curl -fsSL --retry 3 -o autoconf-2.72.tar.xz https://mirrors.kernel.org/gnu/autoconf/autoconf-2.72.tar.xz; \
    echo "ba885c1319578d6c94d46e9b0dceb4014caafe2490e437a0dbca3f270a223f5a  autoconf-2.72.tar.xz" | sha256sum -c -; \
    tar xf autoconf-2.72.tar.xz; cd autoconf-2.72; \
    ./configure --prefix=/usr >/dev/null; make -j"$(nproc)" >/dev/null; make install >/dev/null; \
    cd /tmp; rm -rf autoconf-2.72 autoconf-2.72.tar.xz; \
    autoconf --version | head -1
USER builder
